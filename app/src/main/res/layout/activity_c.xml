<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/my_blue"
    tools:context=".ActivityC">

    <Button
        android:id="@+id/button_open_activity_a"
        android:layout_width="250dp"
        android:layout_height="66dp"
        android:layout_marginTop="208dp"
        android:text="@string/open_activity_a"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button_close_stack"
        android:layout_width="251dp"
        android:layout_height="67dp"
        android:text="@string/close_stack"
        app:layout_constraintStart_toStartOf="@+id/button_close_activity_c"
        app:layout_constraintTop_toBottomOf="@+id/button_close_activity_c" />

    <Button
        android:id="@+id/button_open_activity_d"
        android:layout_width="249dp"
        android:layout_height="71dp"
        android:layout_marginStart="1dp"
        android:text="@string/open_activity_d"
        app:layout_constraintStart_toStartOf="@+id/button_open_activity_a"
        app:layout_constraintTop_toBottomOf="@+id/button_open_activity_a" />

    <Button
        android:id="@+id/button_close_activity_c"
        android:layout_width="250dp"
        android:layout_height="66dp"
        android:text="@string/close_activity_c"
        app:layout_constraintStart_toStartOf="@+id/button_open_activity_d"
        app:layout_constraintTop_toBottomOf="@+id/button_open_activity_d" />


</androidx.constraintlayout.widget.ConstraintLayout>