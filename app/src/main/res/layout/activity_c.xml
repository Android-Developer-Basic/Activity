<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_c"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF2196F3"
    tools:context=".ActivityC">

    <Button
        android:id="@+id/button_open_activity_a"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:text="Open ActivityA"
        app:flow_verticalBias="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.2"
        tools:ignore="HardcodedText" />

    <Button
        android:id="@+id/button_open_activity_d"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:text="Open ActivityD"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/button_open_activity_a"
        app:layout_constraintVertical_bias="0.2"

        tools:ignore="HardcodedText" />

    <Button
        android:id="@+id/button_close_activity_c"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:text="Close ActivityC"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/button_open_activity_d"
        app:layout_constraintVertical_bias="0.2"
        tools:ignore="HardcodedText" />

    <Button
        android:id="@+id/button_close_stack"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:text="Close Stack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/button_close_activity_c"
        app:layout_constraintVertical_bias="0.2"
        tools:ignore="HardcodedText" />

</androidx.constraintlayout.widget.ConstraintLayout>