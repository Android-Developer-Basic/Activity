<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="otus.gpb.homework.activities.sender.SenderActivity">

    <Button
        android:id="@+id/bt_to_gmaps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="120dp"
        android:layout_marginTop="256dp"
        android:text="To Google Maps"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/bt_send_email"
        android:layout_width="166dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Send Email"
        app:layout_constraintStart_toStartOf="@+id/bt_to_gmaps"
        app:layout_constraintTop_toBottomOf="@+id/bt_to_gmaps" />

    <Button
        android:id="@+id/bt_open_rcvr"
        android:layout_width="166dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Open Receiver"
        app:layout_constraintStart_toStartOf="@+id/bt_send_email"
        app:layout_constraintTop_toBottomOf="@+id/bt_send_email" />
</androidx.constraintlayout.widget.ConstraintLayout>