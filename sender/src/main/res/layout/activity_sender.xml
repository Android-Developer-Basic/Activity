<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="otus.gpb.homework.activities.sender.SenderActivity">

    <Button
        android:id="@+id/openGoogleMapBTN"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/to_google_maps"
        android:textSize="12pt"
        app:layout_constraintBottom_toTopOf="@+id/sendEmailBTN"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <Button
        android:id="@+id/sendEmailBTN"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/send_email"
        android:textSize="12pt"
        app:layout_constraintBottom_toTopOf="@+id/openReceiverBTN"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/openGoogleMapBTN" />


    <Button
        android:id="@+id/openReceiverBTN"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open Receiver"
        android:textSize="12pt"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sendEmailBTN" />

</androidx.constraintlayout.widget.ConstraintLayout>